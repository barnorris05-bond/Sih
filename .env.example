# Copy to .env.local (frontend) or export in your shell.
# The demo works without any of these values.

# HS256 signing key for session JWTs. Rotate in every real deployment.
AUTH_SECRET=replace-with-a-64-character-random-string

# Production PostgreSQL path (docker-compose.yml)
DATABASE_URL=postgresql://aicte:aicte_dev_password@localhost:5432/aicte_approval

# Queue backend for production SLA sweeps
REDIS_URL=redis://localhost:6379

# Optional: override the demo JSON store location
# AICTE_DATA_DIR=./backend/.data
