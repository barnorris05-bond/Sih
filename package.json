{
  "name": "aicte-approval-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @aicte/frontend",
    "build": "npm run build -w @aicte/frontend",
    "start": "npm run start -w @aicte/frontend",
    "seed": "npm run seed -w @aicte/backend",
    "typecheck": "npm run typecheck -w @aicte/backend && npm run typecheck -w @aicte/frontend",
    "reset:data": "node -e \"require('fs').rmSync('backend/.data',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18.17"
  }
}
